{
  "name": "glennhammond-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "THE RECORD production prototype for glennhammond.com: Project, Record and Artefact evidence architecture.",
  "scripts": {
    "dev": "vite",
    "build": "vite-react-ssg build && node scripts/postbuild.mjs && node scripts/search-audit.mjs && node scripts/migration-audit.mjs && node scripts/verify.mjs && node scripts/release-audit.mjs",
    "preview": "vite preview --port 4173",
    "images": "node scripts/images.mjs",
    "verify": "node scripts/verify.mjs",
    "release:audit": "node scripts/release-audit.mjs",
    "search:audit": "node scripts/search-audit.mjs",
    "migration:audit": "node scripts/migration-audit.mjs",
    "check": "npm run build && npm run audit",
    "audit": "node scripts/audit.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/source-serif-4": "5.3.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/functions": "^3.9.5",
    "@vercel/speed-insights": "^2.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "vite-react-ssg": "^0.9.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.6.0",
    "sharp": "^0.35.4",
    "vite": "^6.3.5"
  }
}
