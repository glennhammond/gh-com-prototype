{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "git": {
    "deploymentEnabled": {
      "main": false
    }
  },
  "redirects": [
    {
      "source": "/services",
      "destination": "/practice",
      "permanent": true
    },
    {
      "source": "/portfolio",
      "destination": "/work",
      "permanent": true
    },
    {
      "source": "/profile",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/portfolio/migration-to-moodle",
      "destination": "/work/connect-and-learn/concurrent-migration",
      "permanent": true
    },
    {
      "source": "/work/casa-flight-examiner-rating",
      "destination": "/work/casa/flight-examiner-rating",
      "permanent": true
    },
    {
      "source": "/master-slides-in-storyline",
      "destination": "/blog/master-slides-in-storyline",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "p",
          "value": "156463"
        }
      ],
      "destination": "/blog/master-slides-in-storyline",
      "permanent": true
    },
    {
      "source": "/how-to-set-moodles-user-login-page-as-the-sites-landing-page",
      "destination": "/blog/how-to-set-moodles-login-page-as-the-sites-landing-page",
      "permanent": true
    },
    {
      "source": "/blog/how-to-set-moodles-user-login-page-as-the-sites-landing-page",
      "destination": "/blog/how-to-set-moodles-login-page-as-the-sites-landing-page",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "p",
          "value": "164"
        }
      ],
      "destination": "/blog/how-to-set-moodles-login-page-as-the-sites-landing-page",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        }
      ]
    }
  ]
}
